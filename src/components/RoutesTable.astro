---
import type { Route } from "../data/areas";

interface Props {
  areaSlug: string;
  routes: Route[];
}
const { areaSlug, routes } = Astro.props;
const stars = (n: number | null) => (n ? "★".repeat(n) : "");
---

<div class="routes-table">
  <div class="routes-head">
    <span class="label">Route</span>
    <span class="label">Grade</span>
    <span class="label">Length</span>
    <span class="label">Pitches</span>
    <span class="label">First ascent</span>
    <span></span>
  </div>
  {
    routes.map((r) => (
      <a class="route-row" href={`/areas/${areaSlug}/${r.slug}`}>
        <span>
          <span class="rt-name">{r.name}</span>
          {r.stars ? (
            <span class="rt-sub stars">{stars(r.stars)}</span>
          ) : r.status ? (
            <span class="rt-sub note">{r.status}</span>
          ) : null}
        </span>
        <span class="grade">{r.grade}</span>
        <span class="rt-len">{r.length}</span>
        <span class="rt-p">{r.pitches ?? "—"}</span>
        <span class="rt-fa">
          {r.firstAscent}
          {r.year && r.year !== "—" ? <br /> : null}
          {r.year && r.year !== "—" ? r.year : null}
        </span>
        <svg class="go" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path
            d="M3 7h8M7.5 3.5 11 7l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    ))
  }
</div>
