---
import { editHelpUrl } from "../lib/guidebook";

interface Props {
  /** repo-relative path of the markdown file this page renders from */
  path: string;
  /** human label, e.g. "Polish Princess" */
  label: string;
}
const { path, label } = Astro.props;
---

<a class="editlink" href={editHelpUrl(path, label)}>
  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M11.5 2.5a1.6 1.6 0 0 1 2.3 2.3L5.3 13.3l-3 .8.8-3 8.4-8.4Z"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </svg>
  Edit this page
</a>

<style>
  .editlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--mid);
    text-decoration: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.3rem 0.55rem;
    background: var(--surface);
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .editlink:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
