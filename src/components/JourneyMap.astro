---
/**
 * The journey to the Dragon's Horns, drawn as a stylised map:
 * mainland Mersing → ferry across the South China Sea to Tioman's west coast
 * → boat around the south of the island to Kampung Mukut → jungle to the walls.
 * The three legs draw themselves in on load.
 */
---

<figure class="journeymap">
  <svg viewBox="0 0 960 420" role="img"
    aria-label="Map of the journey: from Mersing on the mainland, by ferry across the South China Sea to the west coast of Pulau Tioman, then by boat around the south of the island to Kampung Mukut, then on foot up to the Dragon's Horns.">
    <!-- sea -->
    <rect class="jm-sea" x="0" y="0" width="960" height="420"></rect>

    <!-- mainland -->
    <path class="jm-land" d="M0 0 L168 0 C 168 42 132 70 152 112 C 170 148 128 176 154 216
      C 174 250 130 284 156 322 C 172 356 134 388 156 420 L0 420 Z"></path>

    <!-- Pulau Tioman — elongated N–S, irregular west coast, pointed south end -->
    <path class="jm-land" d="M756 34 C 730 40 720 74 714 108 C 708 132 700 140 690 152
      C 678 166 672 190 676 214 C 680 236 672 250 664 270 C 656 292 664 320 686 340
      C 700 352 714 372 726 372 C 740 372 748 352 760 340 C 780 320 800 300 812 268
      C 824 232 826 176 818 132 C 810 88 792 44 756 34 Z"></path>
    <!-- twin-peak notch near the south end (the Horns) -->
    <path class="jm-ridge" d="M700 316 l8 -20 l6 12 l8 -24 l7 20"></path>

    <!-- legs -->
    <path class="jm-leg jm-ferry" d="M150 214 C 330 150 520 120 676 148" pathLength="100"></path>
    <path class="jm-leg jm-boat" d="M678 156 C 662 206 648 262 664 300 C 676 326 694 340 706 342" pathLength="100"></path>
    <path class="jm-leg jm-jungle" d="M707 340 L710 326 L713 312" pathLength="100"></path>

    <!-- waypoints -->
    <g class="jm-wp jm-wp-1">
      <circle cx="150" cy="214" r="5"></circle>
      <text x="150" y="240" text-anchor="middle">MERSING</text>
    </g>
    <g class="jm-wp jm-wp-2">
      <circle cx="678" cy="150" r="4.5"></circle>
      <text x="672" y="130" text-anchor="middle">West-coast villages</text>
    </g>
    <g class="jm-wp jm-wp-3">
      <circle cx="706" cy="342" r="5"></circle>
      <text x="706" y="366" text-anchor="middle">KAMPUNG MUKUT</text>
    </g>
    <g class="jm-wp jm-wp-4">
      <path class="jm-flag" d="M713 312 l0 -16 l12 5 l-12 5"></path>
      <text x="729" y="300" text-anchor="start">Dragon's Horns</text>
    </g>

    <!-- leg labels -->
    <text class="jm-leglabel jm-ll-1" x="405" y="150" text-anchor="middle">FERRY · ~2 h</text>
    <text class="jm-leglabel jm-ll-2" x="596" y="262" text-anchor="end">BOAT / SEA&nbsp;TAXI</text>

    <!-- ambient labels -->
    <text class="jm-sealabel" x="360" y="330">SOUTH CHINA SEA</text>
    <text class="jm-note" x="405" y="168" text-anchor="middle">≈ 56 km</text>
    <text class="jm-islandlabel" x="770" y="76" text-anchor="middle">PULAU TIOMAN</text>
    <text class="jm-mainlabel" x="18" y="30">PENINSULAR MALAYSIA</text>
  </svg>
  <figcaption>The way in: mainland → Mersing → ferry → boat → Mukut → jungle.</figcaption>
</figure>

<style>
  .journeymap {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }
  .journeymap svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .jm-sea {
    fill: color-mix(in srgb, var(--accent) 9%, var(--surface));
  }
  .jm-land {
    fill: var(--surface-2);
    stroke: var(--faint);
    stroke-width: 1;
  }
  .jm-ridge {
    fill: none;
    stroke: var(--mid);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .jm-leg {
    fill: none;
    stroke: var(--oxide);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: jm-draw 1.6s ease forwards;
  }
  .jm-ferry {
    animation-delay: 0.35s;
  }
  .jm-boat {
    animation-delay: 1.7s;
    animation-duration: 1.4s;
  }
  .jm-jungle {
    stroke-dasharray: 3 4;
    stroke-width: 2.2;
    animation: jm-fade 0.5s ease forwards;
    animation-delay: 3s;
    opacity: 0;
  }
  @keyframes jm-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes jm-fade {
    to {
      opacity: 1;
    }
  }

  .jm-wp circle {
    fill: var(--surface);
    stroke: var(--oxide);
    stroke-width: 2;
  }
  .jm-flag {
    fill: var(--oxide);
  }
  .jm-wp text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .jm-wp {
    opacity: 0;
    animation: jm-fade 0.5s ease forwards;
  }
  .jm-wp-1 {
    animation-delay: 0.15s;
  }
  .jm-wp-2 {
    animation-delay: 1.6s;
  }
  .jm-wp-3 {
    animation-delay: 3s;
  }
  .jm-wp-4 {
    animation-delay: 3.4s;
  }

  .jm-leglabel {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    fill: var(--oxide);
    opacity: 0;
    animation: jm-fade 0.5s ease forwards;
  }
  .jm-ll-1 {
    animation-delay: 1.3s;
  }
  .jm-ll-2 {
    animation-delay: 2.8s;
  }

  .jm-sealabel {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    fill: color-mix(in srgb, var(--accent) 40%, var(--surface));
  }
  .jm-note {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--mid);
  }
  .jm-islandlabel,
  .jm-mainlabel {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    fill: var(--mid);
  }

  .journeymap figcaption {
    padding: 0.7rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--mid);
    background: var(--ground);
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 560px) {
    .jm-mainlabel,
    .jm-note,
    .jm-sealabel {
      display: none;
    }
    .jm-wp text,
    .jm-leglabel,
    .jm-islandlabel {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jm-leg,
    .jm-wp,
    .jm-jungle,
    .jm-leglabel {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }
    .jm-jungle {
      stroke-dasharray: 3 4;
    }
  }
</style>
