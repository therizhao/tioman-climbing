---
/**
 * A horizontally-scrollable strip of photos and short clips from the Dragon's
 * Horns — "what it's like out there".
 *
 * Performance: first paint loads nothing but lazy poster/photo JPEGs. A clip is
 * only fetched when it actually scrolls into the strip's viewport; it then
 * autoplays (muted, looping) and pauses again when it scrolls out.
 */

type Item =
  | { kind: "video"; src: string; poster: string; caption: string }
  | { kind: "photo"; src: string; caption: string };

const items: Item[] = [
  {
    kind: "video",
    src: "/gallery/ledge-exposure.mp4",
    poster: "/gallery/ledge-exposure-poster.jpg",
    caption: "Belayed on a ledge, boots over the void, the coast far below.",
  },
  {
    kind: "video",
    src: "/gallery/topping-out.mp4",
    poster: "/gallery/topping-out-poster.jpg",
    caption: "Following the last slab to the belay, the south of the island behind.",
  },
  {
    kind: "video",
    src: "/gallery/jungle-rappel.mp4",
    poster: "/gallery/jungle-rappel-poster.jpg",
    caption: "Abseiling back into the jungle at the foot of the wall.",
  },
  {
    kind: "video",
    src: "/gallery/topout-over-mukut.mp4",
    poster: "/gallery/topout-over-mukut-poster.jpg",
    caption: "Looking down at Kampung Mukut and the fringing reef from near the top.",
  },
  {
    kind: "video",
    src: "/gallery/belay-view.mp4",
    poster: "/gallery/belay-view-poster.jpg",
    caption: "From the belayer's stance — a pitch of rope out, jungle and sea below.",
  },
  {
    kind: "video",
    src: "/gallery/summit-cloud.mp4",
    poster: "/gallery/summit-cloud-poster.jpg",
    caption: "Topping out on the South Tower as cloud pours over the summit ridge.",
  },
  {
    kind: "photo",
    src: "/gallery/tower-in-cloud.jpg",
    caption: "The North Tower wreathed in cloud, seen from the South Tower.",
  },
  {
    kind: "photo",
    src: "/gallery/horns-from-the-sea.jpg",
    caption: "First sight of the Dragon's Horns — arriving at Mukut by boat.",
  },
];
---

<section class="mediastrip" aria-label="Photos and clips from the Dragon's Horns">
  <div class="wrap ms-head">
    <div>
      <p class="label">Pulau Tioman</p>
      <h2>What it's like out there</h2>
    </div>
    <blockquote>&ldquo;The Dragon will not let you pass easily.&rdquo;</blockquote>
  </div>

  <div class="ms-track" id="ms-track" tabindex="0">
    {
      items.map((it) =>
        it.kind === "video" ? (
          <figure class="ms-card ms-video" data-src={it.src}>
            <img class="ms-media" src={it.poster} alt={it.caption} loading="lazy" decoding="async" />
            <figcaption>{it.caption}</figcaption>
          </figure>
        ) : (
          <figure class="ms-card">
            <img class="ms-media" src={it.src} alt={it.caption} loading="lazy" decoding="async" />
            <figcaption>{it.caption}</figcaption>
          </figure>
        ),
      )
    }
  </div>

  <div class="wrap ms-nav">
    <span class="ms-hint">Scroll or drag</span>
    <div class="ms-arrows">
      <button type="button" class="ms-arrow" data-dir="-1" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
          ><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
      </button>
      <button type="button" class="ms-arrow" data-dir="1" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
          ><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
      </button>
    </div>
  </div>
</section>

<style>
  .mediastrip {
    background: var(--ink);
    color: var(--ground);
    padding-block: clamp(3rem, 7vw, 5.5rem);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }
  .ms-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .ms-head .label {
    color: color-mix(in srgb, var(--ground) 55%, transparent);
  }
  .ms-head h2 {
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--ground);
    margin-top: 0.4rem;
  }
  .ms-head blockquote {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.15rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ground) 82%, transparent);
  }

  .ms-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    touch-action: pan-y;
    scrollbar-width: none;
    padding-inline: max((100% - var(--wide)) / 2, 1.25rem);
    scroll-padding-inline: max((100% - var(--wide)) / 2, 1.25rem);
    cursor: grab;
  }
  .ms-track::-webkit-scrollbar {
    display: none;
  }
  .ms-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .ms-track:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--ground) 60%, transparent);
    outline-offset: 4px;
  }

  .ms-card {
    flex: 0 0 clamp(240px, 68vw, 320px);
    scroll-snap-align: start;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
  }
  .ms-media {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ground) 12%, var(--ink));
    display: block;
  }
  .ms-video::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    pointer-events: none;
    border-radius: 3px;
    transition: opacity 0.3s;
  }
  .ms-video.is-live::before {
    opacity: 0;
  }
  .ms-card figcaption {
    font-size: 0.82rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ground) 68%, transparent);
  }

  .ms-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.75rem;
  }
  .ms-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--ground) 50%, transparent);
  }
  .ms-arrows {
    display: flex;
    gap: 0.6rem;
  }
  .ms-arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--ground) 30%, transparent);
    background: transparent;
    color: var(--ground);
    cursor: pointer;
    transition: border-color 0.18s, background 0.18s;
  }
  .ms-arrow:hover {
    border-color: var(--ground);
    background: color-mix(in srgb, var(--ground) 10%, transparent);
  }
  .ms-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .ms-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { enableHDrag } from "../lib/hdrag";

  const track = document.getElementById("ms-track");
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".ms-card"));
    const arrows = Array.from(document.querySelectorAll<HTMLButtonElement>(".ms-arrow"));
    const prev = arrows.find((a) => a.dataset.dir === "-1")!;
    const next = arrows.find((a) => a.dataset.dir === "1")!;

    const step = () => cards[0].getBoundingClientRect().width + 16;
    const updateArrows = () => {
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft > track.scrollWidth - track.clientWidth - 8;
    };
    arrows.forEach((a) =>
      a.addEventListener("click", () => {
        track.scrollBy({ left: step() * Number(a.dataset.dir), behavior: "smooth" });
      }),
    );
    track.addEventListener("scroll", updateArrows, { passive: true });
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        track.scrollBy({ left: step(), behavior: "smooth" });
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        track.scrollBy({ left: -step(), behavior: "smooth" });
      }
    });
    updateArrows();
    enableHDrag(track);

    // Autoplay in view — but nothing is fetched until the strip itself is on
    // screen AND a given clip is within the strip's horizontal viewport. Clips
    // play / pause with visibility; a clip is only ever downloaded once.
    const videoCards = cards.filter((c) => c.classList.contains("ms-video"));
    const media = new WeakMap<HTMLElement, HTMLVideoElement>();
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const ensureVideo = (card: HTMLElement) => {
      let v = media.get(card);
      if (!v) {
        const img = card.querySelector<HTMLImageElement>("img.ms-media");
        v = document.createElement("video");
        v.className = "ms-media";
        // scoped component styles don't reach a JS-created element, so pin the
        // box here — every clip fills the same 3:4 card as the photos
        v.style.width = "100%";
        v.style.aspectRatio = "3 / 4";
        v.style.objectFit = "cover";
        v.style.display = "block";
        v.style.borderRadius = "3px";
        v.src = card.dataset.src!;
        v.poster = img?.src ?? "";
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.preload = "auto";
        v.setAttribute("aria-label", card.querySelector("figcaption")?.textContent ?? "clip");
        v.addEventListener("playing", () => card.classList.add("is-live"), { once: true });
        card.insertBefore(v, card.firstChild);
        if (img) img.remove(); // drop the poster <img> so it doesn't stack below the video
        media.set(card, v);
      }
      return v;
    };

    // level 2: which clips are within the strip's horizontal viewport
    const cardIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const card = e.target as HTMLElement;
          if (e.isIntersecting && !reduce) {
            ensureVideo(card).play().catch(() => {});
          } else {
            media.get(card)?.pause();
          }
        });
      },
      { root: track, threshold: 0.6 },
    );

    // level 1: is the strip on screen at all? only then do we watch the clips
    let watching = false;
    const sectionIo = new IntersectionObserver(
      (entries) => {
        const onScreen = entries[0].isIntersecting;
        if (onScreen && !watching) {
          watching = true;
          videoCards.forEach((c) => cardIo.observe(c));
        } else if (!onScreen && watching) {
          watching = false;
          videoCards.forEach((c) => {
            cardIo.unobserve(c);
            media.get(c)?.pause();
          });
        }
      },
      { threshold: 0.15 },
    );
    sectionIo.observe(document.querySelector(".mediastrip")!);
  }
</script>
