---
interface Props {
  images: { src: string; caption?: string }[];
  /** short label shown above, e.g. "Topos" */
  label?: string;
}
const { images, label } = Astro.props;
if (images.length === 0) return Astro.redirect("/404"); // never — guarded by callers
const single = images.length === 1;
---

<figure class={`photostrip${single ? " is-single" : ""}`}>
  {label && <figcaption class="ps-label">{label}</figcaption>}
  <div class="ps-track" tabindex={single ? undefined : "0"}>
    {
      images.map((img, i) => (
        <div class="ps-item">
          <a class="ps-link" href={img.src} target="_blank" rel="noopener" aria-label="Open full-resolution image in a new tab">
            <img src={img.src} alt={img.caption || "Topo"} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
          </a>
          {img.caption && <figcaption class="ps-cap">{img.caption}</figcaption>}
        </div>
      ))
    }
  </div>
  {
    !single && (
      <div class="ps-nav">
        <span class="ps-count">
          <span data-ps-current>1</span> / {images.length}
        </span>
        <div class="ps-arrows">
          <button type="button" class="ps-arrow" data-ps-dir="-1" aria-label="Previous image">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="ps-arrow" data-ps-dir="1" aria-label="Next image">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    )
  }
</figure>

<style>
  .photostrip {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .ps-label {
    padding: 0.55rem 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mid);
  }
  .ps-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    touch-action: pan-y;
    scrollbar-width: none;
  }
  .ps-track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .ps-track::-webkit-scrollbar {
    display: none;
  }
  .is-single .ps-track {
    display: block;
    overflow: visible;
  }
  .ps-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }
  .ps-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .ps-link {
    display: block;
    -webkit-touch-callout: default; /* keep the long-press "Save / Open image" menu on iOS */
  }
  .ps-item img {
    width: 100%;
    max-height: 72vh;
    object-fit: contain;
    background: var(--surface-2);
    display: block;
    -webkit-touch-callout: default;
  }
  .ps-cap {
    padding: 0.7rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--mid);
    background: var(--surface);
    border-top: 1px solid var(--rule);
  }
  .ps-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.6rem 0.5rem 1rem;
    background: var(--ground);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--mid);
  }
  .ps-count [data-ps-current] {
    color: var(--ink-2);
  }
  .ps-arrows {
    display: flex;
    gap: 0.4rem;
  }
  .ps-arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition: border-color 0.16s, background 0.16s, color 0.16s;
  }
  .ps-arrow:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }
  .ps-arrow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ps-arrow:disabled {
    opacity: 0.32;
    cursor: default;
  }
</style>

<script>
  import { enableHDrag } from "../lib/hdrag";

  document.querySelectorAll<HTMLElement>(".photostrip:not(.is-single)").forEach((strip) => {
    const track = strip.querySelector<HTMLElement>(".ps-track")!;
    const current = strip.querySelector<HTMLElement>("[data-ps-current]");
    const items = Array.from(track.querySelectorAll<HTMLElement>(".ps-item"));
    const arrows = Array.from(strip.querySelectorAll<HTMLButtonElement>(".ps-arrow"));

    const updateArrows = () => {
      const atStart = track.scrollLeft < 8;
      const atEnd = track.scrollLeft > track.scrollWidth - track.clientWidth - 8;
      arrows.forEach((a) => {
        a.disabled = a.dataset.psDir === "-1" ? atStart : atEnd;
      });
    };

    track.addEventListener(
      "scroll",
      () => {
        const idx = Math.round(track.scrollLeft / track.clientWidth);
        if (current) current.textContent = String(Math.min(items.length, idx + 1));
        updateArrows();
      },
      { passive: true },
    );

    arrows.forEach((a) =>
      a.addEventListener("click", () => {
        track.scrollBy({ left: track.clientWidth * Number(a.dataset.psDir), behavior: "smooth" });
      }),
    );

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") track.scrollBy({ left: track.clientWidth, behavior: "smooth" });
      if (e.key === "ArrowLeft") track.scrollBy({ left: -track.clientWidth, behavior: "smooth" });
    });

    enableHDrag(track);
    updateArrows();
  });
</script>
