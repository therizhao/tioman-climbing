---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import RoutesTable from "../../components/RoutesTable.astro";
import PhotoStrip from "../../components/PhotoStrip.astro";
import EditLink from "../../components/EditLink.astro";
import { getAreas, getArea, getRoutes, externalLogsForArea } from "../../lib/guidebook";

export async function getStaticPaths() {
  const areas = await getAreas();
  return areas.map((a) => ({ params: { area: a.id } }));
}

const { area: areaSlug } = Astro.params;
const area = (await getArea(areaSlug!))!;
const { Content } = await render(area);
const routes = await getRoutes(areaSlug!);

const viaFerrata = routes.filter((r) => r.data.kind === "via-ferrata");
const climbs = routes.filter((r) => r.data.kind !== "via-ferrata");
const split = viaFerrata.length > 0 && climbs.length > 0;

const areaExternal = await externalLogsForArea(area.id);
---

<Base title={area.data.name} description={area.data.desc} section="/">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/#areas">Guidebook</a><span>/</span><span>{area.data.short}</span>
    </nav>

    <div class="detail-hero">
      <div class="detail-head">
        <div>
          <p class="label">Area {area.data.key} · {area.data.aka}</p>
          <h1>{area.data.name}</h1>
        </div>
        <EditLink path={`src/content/areas/${area.id}.md`} label={area.data.name} />
      </div>
      <div class="lede"><Content /></div>
    </div>

    {area.data.images.length > 0 && <PhotoStrip images={area.data.images} label="From the route book" />}

    <div class="meta-strip">
      {
        area.data.meta.map(([k, v]) => (
          <div>
            <span class="label">{k}</span>
            <dd>{v}</dd>
          </div>
        ))
      }
    </div>
  </div>

  <section style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="wrap">
      {
        routes.length === 0 ? (
          <>
            <div class="sec-head">
              <h2>Routes</h2>
            </div>
            <div class="empty">
              <p>{area.data.emptyNote}</p>
            </div>
          </>
        ) : split ? (
          <>
            <div class="sec-head">
              <h2>Not a climber?</h2>
              <p>A fixed cable route to a viewpoint — no rope skills needed.</p>
            </div>
            <RoutesTable areaSlug={area.id} routes={viaFerrata} />
            <div class="sec-head" style="margin-top:3.5rem">
              <h2>Climbing routes</h2>
              <p>One route reaches the North Tower summit.</p>
            </div>
            <RoutesTable areaSlug={area.id} routes={climbs} />
          </>
        ) : (
          <>
            <div class="sec-head">
              <h2>Routes</h2>
              <p>
                Ordered as the source records them. Grades keep their original system. Compare
                across areas in the <a href={`/routes?area=${area.id}`}>route finder</a>.
              </p>
            </div>
            <RoutesTable areaSlug={area.id} routes={routes} />
          </>
        )
      }

      {
        areaExternal.length > 0 && (
          <>
            <div class="sec-head" style="margin-top:3.5rem">
              <h2 style="font-size:var(--step-2)">Trip reports for this area</h2>
            </div>
            <div class="loglist">
              {areaExternal.map((l) => (
                <a class="logitem" href={l.href} target="_blank" rel="noopener">
                  <span class="logitem-kind">
                    {l.kind === "film" ? "Film · external link" : "Article · external link"}
                  </span>
                  <span class="logitem-meta">
                    <span class="logitem-title">{l.title}</span>
                    <span class="logitem-when">
                      {l.people}
                      {l.when ? ` · ${l.when}` : ""}
                    </span>
                  </span>
                  {l.excerpt && <span class="logitem-excerpt">{l.excerpt}</span>}
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>
