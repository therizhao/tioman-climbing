---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PhotoStrip from "../../../components/PhotoStrip.astro";
import EditLink from "../../../components/EditLink.astro";
import { allRoutePairs, getArea, getRoute, stars, addLogUrl } from "../../../lib/guidebook";
import { externalForRoute } from "../../../data/external-logs";

export async function getStaticPaths() {
  const pairs = await allRoutePairs();
  return pairs.map(({ area, route }) => ({ params: { area: area.id, route: route.id } }));
}

const { area: areaSlug, route: routeSlug } = Astro.params;
const area = (await getArea(areaSlug!))!;
const route = (await getRoute(routeSlug!))!;
const r = route.data;
const { Content } = await render(route);

const nativeLogs = (await getCollection("logbook"))
  .filter((e) => e.data.route === route.id)
  .sort((a, b) => a.data.order - b.data.order);
const external = externalForRoute(route.id);

const excerpt = (body: string) =>
  body.replace(/[#*_>`\-]/g, "").replace(/\s+/g, " ").trim().slice(0, 180);
---

<Base title={r.name} description={r.name} section="/">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/#areas">Guidebook</a><span>/</span>
      <a href={`/areas/${area.id}`}>{area.data.short}</a><span>/</span><span>{r.name}</span>
    </nav>

    <article class="routepage">
      <div class="rp-head">
        <div>
          <p class="label">{area.data.name}</p>
          <h1>{r.name}</h1>
          {r.stars ? <p class="stars">{stars(r.stars)}</p> : null}
          {r.status && (
            <p>
              <span class="chip warn">{r.status}</span>
            </p>
          )}
        </div>
        <div class="rp-head-right">
          <EditLink path={`src/content/routes/${route.id}.md`} label={r.name} />
          <div class="rp-grade">
            <span class="g">{r.grade}</span>
            <span class="m">
              {r.length}
              {r.pitches ? ` · ${r.pitches} pitches` : ""}
            </span>
          </div>
        </div>
      </div>

      <dl class="rp-meta">
        <div><span class="label">First ascent</span><dd>{r.firstAscent}</dd></div>
        <div><span class="label">Year</span><dd>{r.year}</dd></div>
        <div><span class="label">Approach</span><dd>{r.approach ?? "—"}</dd></div>
        <div><span class="label">Descent</span><dd>{r.descent ?? "—"}</dd></div>
      </dl>

      {r.images.length > 0 && (
        <div class="rp-topo">
          <PhotoStrip images={r.images} />
        </div>
      )}

      <div class="rp-body">
        <div class="ladder-wrap">
          <span class="label">Pitches</span>
          {
            r.pitchList ? (
              <ol class="ladder">
                {r.pitchList.map((p) => (
                  <li class={`pitch${p.crux ? " crux" : ""}`}>
                    <span class="pitch-n">{p.n}</span>
                    <span class="grade">{p.grade}</span>
                    <span class="pitch-len">{p.length}</span>
                    <span class="pitch-note">{p.note ?? ""}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <div class="empty" style="margin-top:1.25rem">
                <p>
                  No pitch-by-pitch record survives for this route. If you have climbed it, the
                  logbook wants your topo.
                </p>
              </div>
            )
          }
        </div>

        <div class="rp-notes">
          <div class="note-block">
            <h4>{r.kind === "via-ferrata" ? "What it is" : "Character"}</h4>
            <div><Content /></div>
          </div>
          {r.gear && (
            <div class="note-block">
              <h4>Gear</h4>
              <p>{r.gear}</p>
            </div>
          )}
          {r.warn && (
            <div class="warn">
              <p set:html={r.warn} />
            </div>
          )}
          {r.extra && (
            <div class="note-block">
              <h4>{r.extra.title}</h4>
              <p set:html={r.extra.body} />
            </div>
          )}
          <p class="rp-emergency">
            Remote and committing. Emergency contact <strong>Tam Haja</strong>
            <a href="tel:+60129190785">+60&nbsp;12-919&nbsp;0785</a> —
            <a href="/emergency">rescue info</a>.
          </p>
        </div>
      </div>
    </article>
  </div>

  <section style="padding-bottom:0">
    <div class="wrap">
      <div class="sec-head log-head" style="margin-bottom:1.25rem">
        <h2 style="font-size:var(--step-2)">Logbook &amp; trip reports</h2>
        <a class="btn ghost btn-sm" href={addLogUrl(route.id, r.name, area.id)}>
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          Add a trip report
        </a>
      </div>

      {
        nativeLogs.length > 0 || external.length > 0 ? (
          <div class="loglist">
            {nativeLogs.map((e) => (
              <a class="logitem" href={`/logbook/${e.id}`}>
                <span class="logitem-kind">From the Mukut logbook</span>
                <span class="logitem-meta">
                  <span class="logitem-title">{e.data.title}</span>
                  <span class="logitem-when">
                    {e.data.party} · {e.data.date}
                  </span>
                </span>
                <span class="logitem-excerpt">{excerpt(e.body ?? "")}</span>
              </a>
            ))}
            {external.map((l) => (
              <a class="logitem" href={l.url} target="_blank" rel="noopener">
                <span class="logitem-kind">
                  {l.type === "video" ? "Film · external link" : "Article · external link"}
                </span>
                <span class="logitem-meta">
                  <span class="logitem-title">{l.title}</span>
                  <span class="logitem-when">
                    {l.author ? `${l.author} · ` : ""}
                    {l.source}
                    {l.year ? ` · ${l.year}` : ""}
                  </span>
                </span>
                {l.note && <span class="logitem-excerpt">{l.note}</span>}
              </a>
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>
              No trip reports for this route yet. Climbed it? <a href={addLogUrl(route.id, r.name, area.id)}>Add yours</a> — beta,
              conditions, hazards, whatever's useful to the next party.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <div style="height:clamp(2rem,5vw,4rem)"></div>
</Base>
