<script>
  type Rec = { path: string; collection: string; id: string; fmText: string; body: string };
  type Data = {
    catalog: Rec[];
    areas: { id: string; short: string }[];
    routes: { id: string; name: string; area: string }[];
    repo: string;
  };

  const data: Data = JSON.parse(document.getElementById("au-data")!.textContent || "{}");
  const params = new URLSearchParams(location.search);
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  type Field = {
    key: string;
    label: string;
    type: "text" | "textarea" | "number" | "area" | "route" | "select" | "stars";
    help?: string;
    required?: boolean;
    hidden?: boolean;
    options?: string[];
    default?: string;
  };

  const FIELDS: Record<string, Field[]> = {
    logbook: [
      { key: "title", label: "Title", type: "text", required: true, help: "One line — “Naga — three days on the Dragon”." },
      { key: "party", label: "Party / who climbed", type: "text", required: true },
      { key: "date", label: "Date", type: "text", required: true, help: "Free text — “April 2024”, “c. 2015”." },
      { key: "route", label: "Route", type: "route", required: true },
      { key: "routeName", label: "Route name", type: "text", hidden: true },
      { key: "area", label: "Area", type: "area", hidden: true },
      { key: "sourcePage", label: "Route-book page", type: "number", help: "Only if transcribed from the printed route book." },
      { key: "scan", label: "Scan filename", type: "text", help: "e.g. page-67.jpg, if there's a scan of the original page in public/logbook-scans/." },
      { key: "order", label: "Sort order", type: "number", default: "5", help: "Lower shows first; 5 is fine for a new report." },
    ],
    routes: [
      { key: "name", label: "Route name", type: "text", required: true },
      { key: "area", label: "Area", type: "area", required: true },
      { key: "grade", label: "Grade", type: "text", required: true, help: "Keep the route's own system — French / UK / YDS. No conversions." },
      { key: "length", label: "Length", type: "text", help: "“270 m”." },
      { key: "pitches", label: "Pitches", type: "number" },
      { key: "order", label: "Sort order", type: "number", default: "99" },
      { key: "firstAscent", label: "First ascent", type: "text" },
      { key: "year", label: "Year", type: "text" },
      { key: "stars", label: "Stars (0–5)", type: "stars", help: "Cite where the rating comes from in the description." },
      { key: "status", label: "Status note", type: "text", help: "e.g. “Needs documenting”. Optional." },
      { key: "kind", label: "Kind", type: "select", options: ["climb", "via-ferrata"], default: "climb" },
      { key: "approach", label: "Approach", type: "textarea", help: "Short HTML ok — <strong>…</strong>, <a href>…" },
      { key: "descent", label: "Descent", type: "textarea" },
      { key: "gear", label: "Gear", type: "textarea" },
      { key: "warn", label: "Hazard note", type: "textarea", help: "Shown as a warning box. Short HTML ok." },
    ],
    areas: [
      { key: "name", label: "Area name", type: "text", required: true },
      { key: "key", label: "Map key", type: "text", help: "Letter from the overview map, e.g. “H”." },
      { key: "aka", label: "Also known as", type: "text" },
      { key: "short", label: "Short name", type: "text", help: "For breadcrumbs / tables." },
      { key: "order", label: "Sort order", type: "number", default: "99" },
      { key: "desc", label: "One-line description", type: "text" },
      { key: "emptyNote", label: "Note when no routes", type: "textarea" },
    ],
  };

  const MANAGED: Record<string, Set<string>> = {
    logbook: new Set(FIELDS.logbook.map((f) => f.key)),
    routes: new Set(FIELDS.routes.map((f) => f.key)),
    areas: new Set(FIELDS.areas.map((f) => f.key)),
  };

  /* ---------- tiny YAML (line-per-key, as this repo writes it) ---------- */
  const unquote = (s: string) => {
    const t = s.trim();
    if ((t.startsWith('"') && t.endsWith('"')) || (t.startsWith("'") && t.endsWith("'"))) {
      return t.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, "\\");
    }
    return t;
  };
  const parseFm = (text: string) => {
    const entries: { key: string; raw: string }[] = [];
    for (const line of text.split("\n")) {
      const m = line.match(/^([A-Za-z_][\w-]*):\s?(.*)$/);
      if (m) entries.push({ key: m[1], raw: m[2] });
      else if (entries.length) entries[entries.length - 1].raw += "\n" + line;
    }
    return entries;
  };
  const quote = (v: string) => '"' + v.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"';
  const emitScalar = (key: string, v: string) => {
    const t = v.trim();
    if (t === "") return null;
    if (["pitches", "sourcePage", "order", "stars"].includes(key)) {
      return /^-?\d+$/.test(t) ? `${key}: ${t}` : `${key}: ${quote(t)}`;
    }
    if (key === "year") return /^\d{3,4}$/.test(t) ? `${key}: ${t}` : `${key}: ${quote(t)}`;
    return `${key}: ${quote(t)}`;
  };

  /* ---------- mini markdown for the preview ---------- */
  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s: string) =>
    esc(s)
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
      .replace(/(^|[^*])\*([^*]+)\*/g, "$1<em>$2</em>")
      .replace(/_([^_]+)_/g, "<em>$1</em>")
      .replace(/`([^`]+)`/g, "<code>$1</code>");
  const mdToHtml = (md: string) => {
    const out: string[] = [];
    let list: string[] | null = null;
    let quoteBuf: string[] | null = null;
    const flushList = () => {
      if (list) out.push("<ul>" + list.map((li) => `<li>${inline(li)}</li>`).join("") + "</ul>"), (list = null);
    };
    const flushQuote = () => {
      if (quoteBuf) out.push(`<blockquote>${inline(quoteBuf.join(" "))}</blockquote>`), (quoteBuf = null);
    };
    for (const rawLine of md.split("\n")) {
      const line = rawLine.trimEnd();
      if (/^###\s+/.test(line)) { flushList(); flushQuote(); out.push(`<h3>${inline(line.replace(/^###\s+/, ""))}</h3>`); }
      else if (/^##\s+/.test(line)) { flushList(); flushQuote(); out.push(`<h2>${inline(line.replace(/^##\s+/, ""))}</h2>`); }
      else if (/^[-*]\s+/.test(line)) { flushQuote(); (list ||= []).push(line.replace(/^[-*]\s+/, "")); }
      else if (/^>\s?/.test(line)) { flushList(); (quoteBuf ||= []).push(line.replace(/^>\s?/, "")); }
      else if (line.trim() === "") { flushList(); flushQuote(); }
      else { flushList(); flushQuote(); out.push(`<p>${inline(line)}</p>`); }
    }
    flushList(); flushQuote();
    return out.join("\n");
  };

  /* ---------- state ---------- */
  let collection = "logbook";
  let rec: Rec | null = null;
  let mode: "edit" | "new" = "edit";
  let advEntries: { key: string; raw: string }[] = [];
  let orderedKeys: string[] = [];
  let newFilename = "";

  const state: Record<string, string> = {};

  function buildForm() {
    const wrap = $("au-fields");
    wrap.innerHTML = "";
    for (const f of FIELDS[collection]) {
      const l = document.createElement("label");
      l.className = "au-field" + (f.hidden ? " is-hidden" : "");
      l.dataset.key = f.key;
      const span = document.createElement("span");
      span.className = "label";
      span.innerHTML = f.label + (f.required ? ' <span class="au-req">*</span>' : "");
      l.appendChild(span);

      let input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (f.type === "textarea") {
        input = document.createElement("textarea");
        (input as HTMLTextAreaElement).rows = 3;
      } else if (f.type === "select" || f.type === "area" || f.type === "route" || f.type === "stars") {
        input = document.createElement("select");
        let opts: { v: string; t: string }[] = [];
        if (f.type === "area") opts = data.areas.map((a) => ({ v: a.id, t: a.short }));
        else if (f.type === "route") opts = data.routes.map((r) => ({ v: r.id, t: r.name }));
        else if (f.type === "stars") opts = ["", "0", "1", "2", "3", "4", "5"].map((n) => ({ v: n, t: n === "" ? "—" : "★".repeat(+n) || "0" }));
        else opts = (f.options || []).map((o) => ({ v: o, t: o }));
        if (f.type !== "stars" && (!f.required || f.type === "area" || f.type === "route"))
          opts.unshift({ v: "", t: f.type === "route" ? "Choose a route…" : "—" });
        for (const o of opts) {
          const oe = document.createElement("option");
          oe.value = o.v;
          oe.textContent = o.t;
          input.appendChild(oe);
        }
      } else {
        input = document.createElement("input");
        (input as HTMLInputElement).type = f.type === "number" ? "number" : "text";
      }
      input.id = "f-" + f.key;
      input.value = state[f.key] ?? f.default ?? "";
      input.addEventListener("input", () => {
        state[f.key] = input.value;
        if (f.type === "route") syncRoute(input.value);
        render();
      });
      l.appendChild(input);

      if (f.help) {
        const h = document.createElement("span");
        h.className = "au-help";
        h.innerHTML = f.help;
        l.appendChild(h);
      }
      wrap.appendChild(l);
    }
  }

  function syncRoute(routeId: string) {
    const r = data.routes.find((x) => x.id === routeId);
    if (!r) return;
    state.routeName = r.name;
    state.area = r.area;
    const rn = $("f-routeName") as HTMLInputElement | null;
    const ar = $("f-area") as HTMLSelectElement | null;
    if (rn) rn.value = r.name;
    if (ar) ar.value = r.area;
  }

  function buildFile() {
    const managed = MANAGED[collection];
    const lines: string[] = [];
    const emitted = new Set<string>();
    // preserve original key order for edits; append any new managed keys
    const keyOrder = orderedKeys.length
      ? orderedKeys
      : FIELDS[collection].filter((f) => !f.hidden || state[f.key]).map((f) => f.key);
    for (const key of keyOrder) {
      if (emitted.has(key)) continue;
      emitted.add(key);
      if (managed.has(key)) {
        const line = emitScalar(key, state[key] ?? "");
        if (line) lines.push(line);
      } else {
        const adv = advEntries.find((e) => e.key === key);
        if (adv) lines.push(`${key}: ${adv.raw}`);
      }
    }
    for (const f of FIELDS[collection]) {
      if (!emitted.has(f.key) && (state[f.key] ?? "").trim() !== "") {
        const line = emitScalar(f.key, state[f.key]);
        if (line) lines.push(line), emitted.add(f.key);
      }
    }
    for (const e of advEntries) {
      if (!emitted.has(e.key)) lines.push(`${e.key}: ${e.raw}`), emitted.add(e.key);
    }
    const body = ($("au-body") as HTMLTextAreaElement).value.trim();
    return `---\n${lines.join("\n")}\n---\n\n${body}\n`;
  }

  function renderPreview() {
    const box = $("au-preview");
    const body = ($("au-body") as HTMLTextAreaElement).value;
    const parts: string[] = [];
    if (collection === "logbook") {
      parts.push(`<div class="au-pv-title">${esc(state.title || "Untitled report")}</div>`);
      parts.push(`<div class="au-pv-sub">${esc(state.party || "party")} · ${esc(state.date || "date")}</div>`);
      const r = data.routes.find((x) => x.id === state.route);
      if (r) parts.push(`<div class="au-pv-sub">on ${esc(r.name)}</div>`);
    } else if (collection === "routes") {
      parts.push(`<div class="au-pv-title">${esc(state.name || "Unnamed route")}</div>`);
      if (state.stars) parts.push(`<div class="au-pv-stars">${"★".repeat(+state.stars)}</div>`);
      const badges = [state.grade, state.length, state.pitches ? state.pitches + " pitches" : ""]
        .filter(Boolean)
        .map((b) => `<span class="au-pv-badge">${esc(b)}</span>`)
        .join("");
      if (badges) parts.push(`<div class="au-pv-badges">${badges}</div>`);
      if (state.approach) parts.push(`<h2>Approach</h2><p>${state.approach}</p>`);
    } else {
      parts.push(`<div class="au-pv-title">${esc(state.name || "Unnamed area")}</div>`);
      if (state.desc) parts.push(`<div class="au-pv-sub">${esc(state.desc)}</div>`);
    }
    parts.push(`<div class="au-pv-body">${body.trim() ? mdToHtml(body) : '<span class="au-pv-empty">The description preview shows here as you type.</span>'}</div>`);
    box.innerHTML = parts.join("");
  }

  function render() {
    renderPreview();
    const file = buildFile();
    $("au-out").textContent = file;
    ($("au-copy") as HTMLButtonElement).dataset.text = file;

    // GitHub link
    const gh = $("au-gh") as HTMLAnchorElement;
    if (mode === "edit" && rec) {
      gh.href = `${data.repo}/edit/main/${rec.path}`;
      gh.textContent = "Open GitHub to replace the file ↗";
    } else {
      const u = new URL(`${data.repo}/new/main/src/content/${collection}`);
      u.searchParams.set("filename", newFilename);
      if (file.length < 6000) u.searchParams.set("value", file);
      gh.href = u.toString();
      gh.textContent = "Open GitHub to create the file ↗";
    }
  }

  /* ---------- init ---------- */
  function initEdit(path: string) {
    mode = "edit";
    rec = data.catalog.find((r) => r.path === path) || null;
    if (!rec) {
      $("au-title").textContent = "File not found";
      $("au-lede").textContent = `Couldn't find ${path}. Try the “Open GitHub” link, or email rizhaow@gmail.com.`;
      $("au-form").hidden = true;
      return;
    }
    collection = rec.collection;
    const entries = parseFm(rec.fmText);
    orderedKeys = entries.map((e) => e.key);
    advEntries = entries.filter((e) => !MANAGED[collection].has(e.key));
    for (const e of entries) {
      if (MANAGED[collection].has(e.key)) state[e.key] = unquote(e.raw);
    }
    const label = params.get("label") || state.name || state.title || rec.id;
    $("au-title").textContent = `Edit “${label}”`;
    $("au-kicker").textContent = `Editing · ${collection.replace(/s$/, "")}`;
    document.title = `Edit ${label} — Tioman Climbing Guidebook`;
    $("au-file").textContent = rec.path;
    ($("au-body") as HTMLTextAreaElement).value = rec.body;
    if (advEntries.length) {
      $("au-adv").hidden = false;
      ($("au-adv-text") as HTMLTextAreaElement).value = advEntries.map((e) => `${e.key}: ${e.raw}`).join("\n");
    }
    finishInit();
  }

  function initNew() {
    mode = "new";
    collection = "logbook";
    const route = params.get("route") || "";
    const routeName = params.get("routeName") || "";
    const area = params.get("area") || "";
    state.route = route;
    state.routeName = routeName;
    state.area = area;
    state.order = "5";
    state.title = routeName ? `${routeName} — ` : "";
    newFilename = (route || "trip") + "-report.md";
    orderedKeys = FIELDS.logbook.map((f) => f.key);
    $("au-title").textContent = routeName ? `Add a trip report — ${routeName}` : "Add a trip report";
    $("au-kicker").textContent = "New · trip report";
    document.title = "Add a trip report — Tioman Climbing Guidebook";
    $("au-lede").textContent =
      "Approach beta, conditions, how the pitches felt, gear that helped, anything loose or run-out, and thanks. Fill it in, preview, then copy it onto GitHub.";
    ($("au-body") as HTMLTextAreaElement).value =
      "## The climb\n\nHow the approach went, the conditions, how the pitches felt.\n\n## Beta for the next party\n\nGear that helped, loose or run-out sections, anchor state, timing.\n";
    finishInit();
  }

  function finishInit() {
    buildForm();
    if (mode === "new" && state.route) syncRoute(state.route);
    $("au-body-label").textContent = collection === "logbook" ? "Your report" : "Description";
    const steps =
      mode === "edit"
        ? "<b>1.</b> Copy the file contents above. &nbsp; <b>2.</b> Open GitHub — it shows the current file. &nbsp; <b>3.</b> Select all, paste, and click <b>Propose changes</b>. GitHub makes your own copy and opens a pull request."
        : "<b>1.</b> Copy the file contents above. &nbsp; <b>2.</b> Open GitHub — a new file opens, often pre-filled. &nbsp; <b>3.</b> Make sure the contents match, then click <b>Propose new file</b> to open a pull request.";
    $("au-steps").innerHTML = steps;
    $("au-adv-text").addEventListener("input", () => {
      advEntries = parseFm(($("au-adv-text") as HTMLTextAreaElement).value);
      render();
    });
    $("au-body").addEventListener("input", render);
    render();
  }

  $("au-copy").addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.dataset.text || "");
      const old = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = old), 1800);
    } catch {
      btn.textContent = "Press ⌘C to copy";
    }
  });

  if (params.get("path")) initEdit(params.get("path")!);
  else initNew(); // ?new=logbook, or bare /edit-help — a blank trip report, pick the route below
</script>
