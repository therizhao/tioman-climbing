---
import Base from "../layouts/Base.astro";
import { REPO, getAreas } from "../lib/guidebook";
import { getCollection } from "astro:content";

// Raw source of every content file, so the form can round-trip real frontmatter.
const rawFiles = import.meta.glob("../content/**/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

const catalog = Object.entries(rawFiles).map(([abs, raw]) => {
  const rel = abs.replace(/^.*\/content\//, "src/content/");
  const m = rel.match(/src\/content\/([^/]+)\/(.+)\.md$/)!;
  const fm = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  return {
    path: rel,
    collection: m[1],
    id: m[2],
    fmText: fm ? fm[1] : "",
    body: fm ? fm[2].replace(/^\n+/, "") : raw,
  };
});

const areas = (await getAreas()).map((a) => ({ id: a.id, short: a.data.short }));
const routes = (await getCollection("routes"))
  .map((r) => ({ id: r.id, name: r.data.name, area: r.data.area }))
  .sort((a, b) => a.name.localeCompare(b.name));

const payload = JSON.stringify({ catalog, areas, routes, repo: REPO }).replace(/</g, "\\u003c");
---

<Base
  title="Contribute an edit"
  description="Edit the Tioman climbing guidebook or add a trip report — fill in a form, preview it, copy the result and paste it on GitHub."
  section="/"
>
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/#areas">Guidebook</a><span>/</span><span>Contribute</span>
    </nav>

    <div class="detail-hero" style="border-bottom:0">
      <p class="label" id="au-kicker">Contribute</p>
      <h1 id="au-title">Edit the guidebook</h1>
      <p class="lede" id="au-lede">
        Fill in the fields below, preview how it will read, then copy the result and paste it
        into GitHub. A maintainer reviews every change before it goes live.
      </p>
    </div>

    <div class="au-prereq" id="au-prereq">
      <div>
        <span class="label">One thing first</span>
        <p>
          You need a free <a href="https://github.com/signup" target="_blank" rel="noopener"
            >GitHub account</a
          >. Nothing to install — you'll paste this file into GitHub in the browser, and that
          creates a suggested change (a pull request). You can't break anything.
        </p>
      </div>
      <div class="au-file mono" id="au-file"></div>
    </div>

    <div class="au-grid">
      <form class="au-form" id="au-form" autocomplete="off">
        <div id="au-fields"></div>

        <details class="au-adv" id="au-adv" hidden>
          <summary>Advanced fields</summary>
          <p class="note">
            Structured lists — pitch table, photos, topos — kept as raw YAML. Leave them alone
            unless you know the format; they're preserved exactly as they are now.
          </p>
          <textarea id="au-adv-text" rows="6" spellcheck="false"></textarea>
        </details>

        <label class="au-field">
          <span class="label" id="au-body-label">Description</span>
          <textarea id="au-body" rows="12" spellcheck="false"></textarea>
          <span class="au-help"
            >Markdown. <code>## Heading</code>, <code>**bold**</code>, <code>_italic_</code>,
            <code>[link](https://…)</code>, <code>&gt; quote</code>, <code>- list</code>.</span
          >
        </label>
      </form>

      <aside class="au-side">
        <div class="au-preview-card">
          <span class="label">Preview</span>
          <div id="au-preview" class="au-preview"></div>
        </div>
      </aside>
    </div>

    <div class="au-output" id="au-output">
      <div class="au-output-head">
        <span class="label">The file</span>
        <div class="au-out-actions">
          <button type="button" class="btn btn-sm" id="au-copy">Copy file contents</button>
          <a class="btn ghost btn-sm" id="au-gh" href={REPO} target="_blank" rel="noopener"
            >Open GitHub to paste ↗</a
          >
        </div>
      </div>
      <pre class="au-code"><code id="au-out"></code></pre>
      <p class="au-steps note" id="au-steps"></p>
    </div>

    <p class="au-fallback note">
      Stuck, or have photos to add? Just email
      <a href="mailto:rizhaow@gmail.com">rizhaow@gmail.com</a> — or
      <a href="/contribute">see other ways to contribute</a>.
    </p>
  </div>

  <div style="height:clamp(2rem,5vw,4rem)"></div>

  <script type="application/json" id="au-data" set:html={payload}></script>
</Base>

