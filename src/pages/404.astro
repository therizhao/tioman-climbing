---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" section="/">
  <div class="wrap">
    <div class="detail-hero" style="border-bottom:0">
      <p class="label">404</p>
      <h1>That route doesn't go</h1>
      <p class="lede">
        The page you were after isn't here. Head back to <a href="/#areas">the areas</a> or the
        <a href="/logbook">logbook</a>.
      </p>
    </div>
  </div>
  <div style="height:clamp(3rem,8vw,6rem)"></div>
</Base>
