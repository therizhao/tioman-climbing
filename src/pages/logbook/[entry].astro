---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import PhotoStrip from "../../components/PhotoStrip.astro";
import EditLink from "../../components/EditLink.astro";
import { getArea } from "../../lib/guidebook";

export async function getStaticPaths() {
  const entries = await getCollection("logbook");
  return entries.map((entry) => ({ params: { entry: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const area = await getArea(entry.data.area);

const scans =
  entry.data.scans.length > 0
    ? entry.data.scans
    : entry.data.scan
      ? [
          {
            src: `/logbook-scans/${entry.data.scan}`,
            caption: `Route book, source page ${entry.data.sourcePage}`,
          },
        ]
      : [];
---

<Base title={entry.data.title} description={`${entry.data.party} · ${entry.data.date}`} section="/logbook">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/#areas">Guidebook</a><span>/</span>
      {
        area && (
          <>
            <a href={`/areas/${entry.data.area}`}>{area.data.short}</a>
            <span>/</span>
            <a href={`/areas/${entry.data.area}/${entry.data.route}`}>{entry.data.routeName}</a>
            <span>/</span>
          </>
        )
      }
      <span>Logbook</span>
    </nav>

    <div class="detail-hero" style="border-bottom:0">
      <div class="detail-head">
        <div>
          <p class="label">From the Mukut logbook</p>
          <h1>{entry.data.title}</h1>
        </div>
        <EditLink path={`src/content/logbook/${entry.id}.md`} label={entry.data.title} />
      </div>
      <p class="lede" style="font-family:var(--font-mono);font-size:.86rem">
        {entry.data.party} &nbsp;·&nbsp; {entry.data.date} &nbsp;·&nbsp;
        <a href={`/areas/${entry.data.area}/${entry.data.route}`}>{entry.data.routeName}</a>
      </p>
    </div>

    <div class={scans.length ? "logpage" : "logpage logpage-noscan"}>
      <div class="transcript">
        <Content />
      </div>

      {
        scans.length > 0 && (
          <div class="scan-panel-wrap">
            <PhotoStrip images={scans} label="Original page" />
          </div>
        )
      }
    </div>

    <p class="notice" style="margin-top:2.5rem;max-width:var(--read)">
      A climber's personal trip report, reproduced for the record. Transcriptions may contain
      errors — check against the scan where there is one. To have anything credited differently
      or removed, email <a href="mailto:rizhaow@gmail.com">rizhaow@gmail.com</a>.
      {
        area && (
          <>
            {" "}
            See also the <a href={`/areas/${entry.data.area}/${entry.data.route}`}>{entry.data.routeName}</a>{" "}
            route page.
          </>
        )
      }
    </p>
  </div>

  <div style="height:clamp(2rem,5vw,4rem)"></div>
</Base>

<style>
  .scan-panel-wrap {
    position: sticky;
    top: 5rem;
  }
</style>
